# Copie para .env (na raiz do repo) e preencha. Nunca commite o .env.

# --- Agora (console.agora.io) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Developer Toolkit > RESTful API. Se vazio, a API usa autenticação por token.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- LLM próprio (OpenAI-compatível) chamado pelo nosso /v1/chat/completions ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# custom = Agora chama o nosso LLM (ferramentas). agora = LLM padrão gerenciado pela Agora.
LLM_MODE=custom
# Segredo que a Agora envia ao nosso LLM (Authorization). Opcional, recomendado.
LLM_SHARED_SECRET=

# --- Acesso ---
# Token JWT assinado no /auth/sso (login simulado, sem senha). Com true, as ações da central
# (publicar/atribuir rota, cadastrar motorista, assumir Task, responder chamado, ligar) exigem papel "cco".
AUTH_OBRIGATORIA=true
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SEGREDO=
AUTH_TOKEN_VALIDADE_H=12
# Origens do painel web liberadas no CORS (JSON). Inclua a URL da demo publicada.
CORS_ORIGENS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]
# Ligações disparadas à mão: no máximo N por rota a cada janela (s). 0 desliga.
LIGACOES_MANUAIS_MAX=5
LIGACOES_MANUAIS_JANELA_S=600

# --- URL pública do túnel (cloudflared/ngrok) apontando para a porta 8000 ---
PUBLIC_URL=

# --- Ligação ao recebedor: rtc (plano B, navegador) ou sip (plano A, número importado) ---
RECEBEDOR_MODO=rtc
AGORA_SIP_FROM_NUMBER=
RECEBEDOR_TELEFONE_E164=+5519900000002

# --- Chamada do agente: Twilio PSTN e fallback Agora RTC para /operador ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_OPERATOR_PHONE_E164=
TWILIO_SUPERVISOR_PHONE_E164=
CHAMADA_OPERADOR_TIMEOUT_S=30

# --- Voz (presets gerenciados da Agora: Deepgram nova-3 + MiniMax) ---
ASR_LANGUAGE=pt-BR
TTS_VOICE_ID=Portuguese_Deep-VoicedGentleman
TTS_VOICE_ID_RECEBEDOR=Portuguese_Deep-VoicedGentleman

# --- Ritmo da demo ---
CCO_INTERVALO_S=20
CCO_MAX_TENTATIVAS=3
# 1 = tempo real. 600 = 1 s real conta 10 min de estadia (declarado no README).
ESTADIA_ACELERACAO=600
LIGAR_RECEBEDOR_NA_APROXIMACAO=false
LIGACAO_TIMEOUT_S=180
