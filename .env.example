# Copie para .env (na raiz do repo) e preencha. Nunca commite o .env.

# --- LiveKit (LiveKit Cloud ou servidor self-hosted) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=rodar-voice-agent
# Trunk outbound criado no LiveKit SIP. Obrigatório para RECEBEDOR_MODO=sip.
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_FROM_NUMBER=

# --- LLM próprio (OpenAI-compatível) chamado pelo nosso /v1/chat/completions ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Segredo usado pelo gateway privado do LLM. Opcional, recomendado.
LLM_SHARED_SECRET=

# --- Acesso ---
# Token JWT assinado no /auth/sso (login simulado, sem senha). Com true (padrão), toda escrita exige token:
# as ações da central exigem papel "cco" e o motorista só mexe na rota atribuída a ele.
# false só em desenvolvimento local.
AUTH_OBRIGATORIA=true
# Obrigatório com AUTH_OBRIGATORIA=true (32+ caracteres; a api não sobe sem ele).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SEGREDO=
AUTH_TOKEN_VALIDADE_H=12
# Origens do painel web liberadas no CORS (JSON). Inclua a URL da demo publicada.
CORS_ORIGENS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]
# Ligações disparadas à mão: no máximo N por rota a cada janela (s). 0 desliga.
LIGACOES_MANUAIS_MAX=5
LIGACOES_MANUAIS_JANELA_S=600

# --- URL pública do túnel (cloudflared/ngrok) apontando para a porta 8000 ---
PUBLIC_URL=

# --- Ligação ao recebedor: rtc (navegador) ou sip (telefone via trunk LiveKit) ---
RECEBEDOR_MODO=rtc
RECEBEDOR_TELEFONE_E164=+5519900000002

# --- Chamada do agente: Twilio PSTN e fallback LiveKit RTC para /operador ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_OPERATOR_PHONE_E164=
TWILIO_SUPERVISOR_PHONE_E164=
CHAMADA_OPERADOR_TIMEOUT_S=30

# --- Modelo de voz do LiveKit Inference ---
LIVEKIT_MODEL=google/gemini-3.8-live
LIVEKIT_VOICE=Charon

# --- Ritmo da demo ---
CCO_INTERVALO_S=20
CCO_MAX_TENTATIVAS=3
# 1 = tempo real. 600 = 1 s real conta 10 min de estadia (declarado no README).
ESTADIA_ACELERACAO=600
LIGAR_RECEBEDOR_NA_APROXIMACAO=false
LIGACAO_TIMEOUT_S=180
