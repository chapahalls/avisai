resource "aws_service_discovery_private_dns_namespace" "rumolog" {
  name        = var.service_discovery_namespace
  description = "Service discovery interno do rodar-backend (sem ALB)"
  vpc         = var.vpc_id
}

resource "aws_service_discovery_service" "api" {
  name = "api"

  dns_config {
    namespace_id = aws_service_discovery_private_dns_namespace.rumolog.id

    dns_records {
      ttl  = 10
      type = "A"
    }

    routing_policy = "MULTIVALUE"
  }

  health_check_custom_config {
    failure_threshold = 1
  }
}
